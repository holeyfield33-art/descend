# Descend DM0 environment example
# Copy to .env and fill values. Never commit real secrets.

# Agent model (future Nebius / Nemotron)
# AGENT_MODEL_ID=nemotron-...
# AGENT_API_BASE=
# AGENT_API_KEY=

# Target model (future)
# TARGET_MODEL_ID=
# TARGET_API_BASE=
# TARGET_API_KEY=

# Registry storage path (default: ./registry_data)
# REGISTRY_PATH=./registry_data

# Run workspace root
# WORKSPACE_ROOT=./runs
